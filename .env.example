# Used by docker-compose.yml when running the full stack in containers.
# Copy to .env and fill in real values. Never commit .env.
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-secret
SETTINGS_ENCRYPTION_KEY=replace-with-yet-another-random-64-char-hex-secret
WHATSAPP_PROVIDER=mock
WEB_APP_URL=http://localhost:8085

# --- Dados de demonstracao (usados por `npm run prisma:seed` no container api) ---
# SEED_DEMO_DATA=false      -> nao cria os dados de exemplo (so admin/gestor)
# SEED_DEMO_FORCE=true      -> apaga APENAS a demonstracao e recria com datas de hoje
# SEED_DEMO_REMOVE=true     -> remove a demonstracao por completo (conexoes demo, dados e atendentes de exemplo)
# SEED_DEMO_PASSWORD=...    -> senha de todos os usuarios de demonstracao
#                              (padrao: ***REMOVIDO*** / ***REMOVIDO*** / ***REMOVIDO*** — TROQUE em producao)
