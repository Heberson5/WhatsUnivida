# Used by docker-compose.yml when running the full stack in containers.
# Copy to .env and fill in real values. Never commit .env.
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-secret
SETTINGS_ENCRYPTION_KEY=replace-with-yet-another-random-64-char-hex-secret
WHATSAPP_PROVIDER=mock
WEB_APP_URL=https://whatsunivida.sauberlich.com.br
# Largest file an agent can attach in Atendimento, in MB (default 25). The web
# container's nginx lets up to 100 MB through, so don't set it higher than that.
# UPLOAD_MAX_SIZE_MB=25
